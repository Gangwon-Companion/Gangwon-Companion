{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "HTTP throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{application=\"gangwon-companion\"}[$__rate_interval]))", "legendFormat": "req/s" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "title": "HTTP latency p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"gangwon-companion\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"gangwon-companion\"}[$__rate_interval])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "title": "HTTP error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{application=\"gangwon-companion\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"gangwon-companion\"}[$__rate_interval])), 1)", "legendFormat": "5xx ratio" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] }
    },
    {
      "title": "HikariCP connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        { "expr": "hikaricp_connections_active{application=\"gangwon-companion\"}", "legendFormat": "active" },
        { "expr": "hikaricp_connections_idle{application=\"gangwon-companion\"}", "legendFormat": "idle" },
        { "expr": "hikaricp_connections_pending{application=\"gangwon-companion\"}", "legendFormat": "pending" },
        { "expr": "hikaricp_connections_max{application=\"gangwon-companion\"}", "legendFormat": "max" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "title": "JVM CPU / heap",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        { "expr": "process_cpu_usage{application=\"gangwon-companion\"}", "legendFormat": "CPU" },
        { "expr": "sum(jvm_memory_used_bytes{application=\"gangwon-companion\",area=\"heap\"}) / sum(jvm_memory_max_bytes{application=\"gangwon-companion\",area=\"heap\"})", "legendFormat": "heap" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] }
    },
    {
      "title": "PostgreSQL connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [{ "expr": "sum(pg_stat_activity_count) by (state)", "legendFormat": "{{state}}" }],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "title": "Kafka consumer lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [{ "expr": "sum(kafka_consumergroup_lag) by (consumergroup)", "legendFormat": "{{consumergroup}}" }],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "title": "Indexer p95: processing / end-to-end",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(search_indexer_processing_seconds_bucket[$__rate_interval])))", "legendFormat": "processing p95" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(search_indexer_end_to_end_seconds_bucket[$__rate_interval])))", "legendFormat": "end-to-end p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "title": "Elasticsearch indexing / rejected",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        { "expr": "sum(rate(elasticsearch_indices_indexing_index_total[$__rate_interval]))", "legendFormat": "indexed/s" },
        { "expr": "sum(rate(elasticsearch_thread_pool_rejected_count[$__rate_interval])) by (name)", "legendFormat": "rejected {{name}}" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "title": "Spring logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{application=\"gangwon-companion\"}", "refId": "A" }],
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "enableLogDetails": true }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["gangwon", "load-test"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "title": "Gangwon Companion - Load Test",
  "uid": "gangwon-load-test",
  "version": 1
}
